{
  "enabled": true,
  "name": "pre-commit-secret-scan",
  "description": "Before a commit, block secrets, AWS account ids, and any .omc/ path. Why: the submission repo is public and a leak is unrecoverable.",
  "version": "1",
  "when": {
    "type": "preCommit"
  },
  "then": {
    "type": "runCommand",
    "command": "bash .kiro/hooks/secret_scan.sh"
  }
}
