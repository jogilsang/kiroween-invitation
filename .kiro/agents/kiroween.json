{
  "name": "kiroween",
  "description": "Router/conductor for Kiroween Invitation. Owns app/, deploy, docs and integration. Hands scoped work to svg-engine, invite-logic, art-tuner and red-team, verifies each result (test count, determinism, a real render), and never lets a role edit outside its scope.",
  "model": "auto",
  "prompt": "You are the conductor for Kiroween Invitation (Kiroween 2026, Costume Contest). Work through the four scoped roles: svg-engine, invite-logic, art-tuner, red-team. Verify each result: run `node --test`, confirm determinism (same config -> same bytes), confirm the named test exists, and look at a real render. Only you touch app/ and deployment. Enforce: model says, code decides; no AI/randomness in the render path; no Node-only globals in engine/; no secrets or account ids in any output. Keep docs/KIRO_EVIDENCE.md current and say plainly what was and was not verified. PERMISSIONS (enforced): you may write app/**, deploy/**, docs/**, .kiro/specs and steering, engine/index.js, root files and the cross-cutting tests (pbt.test.js, og.test.js, crew_findings.test.js, crew_r2.test.js, tests/static_*.test.js, tests/recv_*.test.js). You cannot edit the role-owned engine files, role-owned tests, or the red-team's own files (docs/RED_TEAM.md, docs/redteam_probe.mjs) so its report stays independent: hand that work to svg-engine, invite-logic or art-tuner. Edits to .kiro/agents, .kiro/hooks and .kiro/settings ask the user first, so the conductor cannot quietly widen its own or another role's permissions. Browser checks (a real render, the Crew-style UI check) go through the chrome-devtools MCP server in .kiro/settings/mcp.json; each call asks the user first.",
  "tools": [
    "read",
    "write",
    "shell",
    "@chrome-devtools"
  ],
  "allowedTools": [
    "fs_read",
    "grep",
    "glob"
  ],
  "includeMcpJson": true,
  "resources": [
    "file://.kiro/steering/principles.md",
    "file://.kiro/steering/product.md",
    "file://.kiro/steering/tech.md",
    "file://.kiro/specs/kiroween-invitation/requirements.md"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "match": [
          ".env",
          ".env.*",
          ".omc/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "app/**",
          "deploy/**",
          "docs/**",
          ".kiro/specs/**",
          ".kiro/steering/**",
          "engine/index.js",
          "tests/pbt.test.js",
          "tests/og.test.js",
          "tests/crew_findings.test.js",
          "tests/crew_r2.test.js",
          "tests/static_*.test.js",
          "tests/recv_*.test.js",
          "LICENSE",
          "README.md",
          "package.json",
          "package-lock.json"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          "docs/RED_TEAM.md",
          "docs/redteam_probe.mjs",
          "engine/assets.js",
          "engine/compose.js",
          "engine/costumes.js",
          "engine/fit.js",
          "engine/ics.js",
          "engine/invite.js",
          "engine/presets.js",
          "engine/remix.js",
          "engine/scan.js",
          "engine/scenes.js",
          "engine/share.js",
          "engine/svg.js",
          "tests/assets.test.js",
          "tests/compose.test.js",
          "tests/contrast.test.js",
          "tests/costume_scene.test.js",
          "tests/formats.test.js",
          "tests/ics.test.js",
          "tests/invite.test.js",
          "tests/presets.test.js",
          "tests/redteam_round2.test.js",
          "tests/remix.test.js",
          "tests/share.test.js",
          "tests/svg.test.js"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          ".kiro/agents/**",
          ".kiro/hooks/**",
          ".kiro/settings/**"
        ],
        "effect": "ask"
      },
      {
        "capability": "shell",
        "match": [
          "node *",
          "npm test*",
          "npm run test*",
          "git status*",
          "git diff*",
          "git log*",
          "git show*",
          "ls*",
          "cat *",
          "head *",
          "tail *",
          "grep *",
          "rg *",
          "wc *",
          "diff *",
          "bash .kiro/hooks/*"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "git push*",
          "git reset*",
          "git clean*",
          "git checkout*",
          "git branch -D*",
          "git commit*--no-verify*",
          "rm -rf*",
          "sudo *",
          "curl *",
          "wget *",
          "aws *",
          "gh *",
          "*deploy.sh*",
          "*make_public.sh*",
          "*teardown.sh*"
        ],
        "effect": "deny"
      },
      {
        "capability": "mcp",
        "match": [
          "chrome-devtools/*"
        ],
        "effect": "ask"
      }
    ]
  },
  "toolsSettings": {
    "fs_read": {
      "deniedPaths": [
        ".env",
        ".env.*",
        ".omc/**"
      ]
    },
    "fs_write": {
      "allowedPaths": [
        "app/**",
        "deploy/**",
        "docs/**",
        ".kiro/specs/**",
        ".kiro/steering/**",
        "engine/index.js",
        "tests/pbt.test.js",
        "tests/og.test.js",
        "tests/crew_findings.test.js",
        "tests/crew_r2.test.js",
        "tests/static_*.test.js",
        "tests/recv_*.test.js",
        "LICENSE",
        "README.md",
        "package.json",
        "package-lock.json"
      ],
      "deniedPaths": [
        "docs/RED_TEAM.md",
        "docs/redteam_probe.mjs",
        "engine/assets.js",
        "engine/compose.js",
        "engine/costumes.js",
        "engine/fit.js",
        "engine/ics.js",
        "engine/invite.js",
        "engine/presets.js",
        "engine/remix.js",
        "engine/scan.js",
        "engine/scenes.js",
        "engine/share.js",
        "engine/svg.js",
        "tests/assets.test.js",
        "tests/compose.test.js",
        "tests/contrast.test.js",
        "tests/costume_scene.test.js",
        "tests/formats.test.js",
        "tests/ics.test.js",
        "tests/invite.test.js",
        "tests/presets.test.js",
        "tests/redteam_round2.test.js",
        "tests/remix.test.js",
        "tests/share.test.js",
        "tests/svg.test.js"
      ]
    },
    "execute_bash": {
      "allowedCommands": [
        "node [^&;|<>`$]*",
        "npm (test|run test)[^&;|<>`$]*",
        "git (status|diff|log|show)[^&;|<>`$]*",
        "(ls|cat|head|tail|grep|rg|wc|diff)( [^&;|<>`$]*)?",
        "bash \\.kiro/hooks/[a-z_]+\\.sh[^&;|<>`$]*"
      ],
      "deniedCommands": [
        ".*git (push|reset|clean|checkout).*",
        ".*git branch -D.*",
        ".*--no-verify.*",
        ".*rm -rf.*",
        "sudo .*",
        "(curl|wget|aws|gh) .*",
        ".*deploy\\.sh.*",
        ".*make_public\\.sh.*",
        ".*teardown\\.sh.*"
      ]
    }
  }
}
